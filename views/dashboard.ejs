<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-secondary mb-0">Today at a glance</p>
  </div>
  <a href="/patients/new" class="btn btn-primary">Register Patient</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <p class="text-secondary mb-2">Today's Total Patients</p>
        <p class="display-5 fw-semibold mb-0"><%= todayTotal %></p>
      </div>
    </div>
  </div>
  <div class="col-sm-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <p class="text-secondary mb-2">Current Token Number</p>
        <p class="display-5 fw-semibold text-primary mb-0"><%= currentToken %></p>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white py-3">
    <h2 class="h5 mb-0">Recently Registered Patients</h2>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Token</th><th>Patient</th><th>CNIC</th><th>Consultant</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% if (!recentPatients.length) { %>
          <tr><td colspan="5" class="text-center text-secondary py-4">No patients registered yet.</td></tr>
        <% } %>
        <% recentPatients.forEach((patient) => { %>
          <tr>
            <td><span class="badge text-bg-primary fs-6"><%= patient.tokenNumber %></span></td>
            <td><%= patient.patientName %></td>
            <td><%= formatCnic(patient.cnic) %></td>
            <td><%= patient.consultant ? patient.consultant.name : 'Deleted consultant' %></td>
            <td><%= formatDateTime(patient.createdAt) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
