<%- include('partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-secondary mb-0">Today at a glance</p>
  </div>
  <a href="/patients/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Register Patient</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-12">
    <div class="card metric-card metric-card-patients h-100">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <p class="metric-label mb-2">Today's Total Patients</p>
          <p class="metric-value mb-0"><%= todayTotal %></p>
        </div>
        <span class="metric-icon"><i class="bi bi-people"></i></span>
      </div>
    </div>
  </div>
</div>

<div class="card app-card">
  <div class="card-header bg-white py-3">
    <h2 class="h5 mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Recently Registered Patients</h2>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>MR Number</th><th>Token</th><th>Patient</th><th>CNIC</th><th>Physician</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% if (!recentPatients.length) { %>
          <tr><td colspan="6" class="text-center text-secondary py-4">No patients registered yet.</td></tr>
        <% } %>
        <% recentPatients.forEach((patient) => { %>
          <tr>
            <td class="text-nowrap fw-semibold"><%= patient.mrNumber %></td>
            <td><span class="badge text-bg-primary fs-6"><%= patient.tokenNumber %></span></td>
            <td><%= patient.patientName %></td>
            <td><%= formatCnic(patient.cnic) %></td>
            <td><%= patient.consultant ? patient.consultant.name : 'Deleted physician' %></td>
            <td><%= formatDateTime(patient.createdAt) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
