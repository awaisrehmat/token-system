<%- include('../partials/header') %>

<div class="page-heading mb-4">
  <h1 class="h3 mb-1">Receipt Settings</h1>
  <p class="text-secondary mb-0">Manage patient-token and sale-receipt print content independently.</p>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger app-alert">
    <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
  </div>
<% } %>

<div class="row g-4">
  <div class="col-lg-7">
    <form action="/settings/receipt" method="post" class="card app-card">
      <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0"><i class="bi bi-ticket-perforated me-2 text-primary"></i>Patient Token Content</h2>
      </div>
      <div class="card-body p-4">
        <div class="mb-4">
          <label for="printHeader" class="form-label">Token header</label>
          <input type="text" class="form-control" id="printHeader" name="header" maxlength="120" value="<%= printSetting.header %>" required>
          <div class="form-text">Used as the clinic name throughout the application and at the top of printed receipts.</div>
        </div>
        <div>
          <label for="printFooter" class="form-label">Token footer</label>
          <textarea class="form-control" id="printFooter" name="footer" maxlength="250" rows="3" required><%= printSetting.footer %></textarea>
          <div class="form-text">Displayed at the bottom of printed patient tokens.</div>
        </div>
        <div class="form-check form-switch mt-4">
          <input class="form-check-input" type="checkbox" role="switch" id="tokenA4" name="tokenA4" <%= printSetting.tokenPaperSize === 'A4' ? 'checked' : '' %>>
          <label class="form-check-label fw-semibold" for="tokenA4">Print patient tokens on A4 paper</label>
          <div class="form-text">On: A4 page. Off: compact 80mm receipt, the current default.</div>
        </div>
      </div>
      <div class="card-footer bg-white d-flex justify-content-end p-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i> Save Settings</button>
      </div>
    </form>
  </div>

  <div class="col-lg-5">
    <div class="card app-card receipt-preview-card">
      <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Preview</h2></div>
      <div class="card-body p-4">
        <div class="receipt-preview">
          <h3><%= printSetting.header %></h3>
          <p>Patient Token · <%= printSetting.tokenPaperSize === 'A4' ? 'A4' : '80mm' %></p>
          <div class="receipt-preview-line"></div>
          <div class="receipt-preview-row"><span>Invoice</span><strong>INV-260730-001</strong></div>
          <div class="receipt-preview-row"><span>Total</span><strong>Rs. 950.00</strong></div>
          <div class="receipt-preview-line"></div>
          <small><%= printSetting.footer %></small>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mt-1">
  <div class="col-lg-7">
    <form action="/settings/sale-receipt" method="post" class="card app-card">
      <div class="card-header bg-white py-3"><h2 class="h5 mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Sale Receipt Content</h2></div>
      <div class="card-body p-4">
        <div class="mb-4">
          <label for="saleHeader" class="form-label">Sale receipt header</label>
          <input type="text" class="form-control" id="saleHeader" name="saleHeader" maxlength="120" value="<%= printSetting.saleHeader || printSetting.header || 'My Clinic' %>" required>
          <div class="form-text">Displayed at the top of printed medicine-sale bills.</div>
        </div>
        <div>
          <label for="saleFooter" class="form-label">Sale receipt footer</label>
          <textarea class="form-control" id="saleFooter" name="saleFooter" maxlength="250" rows="3" required><%= printSetting.saleFooter || 'Thank you for your purchase.' %></textarea>
          <div class="form-text">Displayed at the bottom of printed medicine-sale bills.</div>
        </div>
      </div>
      <div class="card-footer bg-white d-flex justify-content-end p-3"><button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i> Save Sale Receipt</button></div>
    </form>
  </div>
  <div class="col-lg-5">
    <div class="card app-card receipt-preview-card">
      <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Sale Receipt Preview</h2></div>
      <div class="card-body p-4"><div class="receipt-preview"><h3><%= printSetting.saleHeader || printSetting.header || 'My Clinic' %></h3><p>Medicine Sale Receipt</p><div class="receipt-preview-line"></div><div class="receipt-preview-row"><span>Invoice</span><strong>INV-260801-001</strong></div><div class="receipt-preview-row"><span>Total</span><strong>Rs. 950.00</strong></div><div class="receipt-preview-line"></div><small><%= printSetting.saleFooter || 'Thank you for your purchase.' %></small></div></div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
