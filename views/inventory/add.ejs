<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Add Medicine Stock</h1>
    <p class="text-secondary mb-0">Create a medicine batch or add stock to an existing batch</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/inventory/upload" class="btn btn-outline-primary"><i class="bi bi-cloud-arrow-up me-1"></i> CSV Upload</a>
    <a href="/inventory" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Inventory</a>
  </div>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger app-alert">
    <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
  </div>
<% } %>

<div class="row justify-content-center">
  <div class="col-xl-9">
    <form action="/inventory/add" method="post" class="card app-card">
      <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0"><i class="bi bi-capsule me-2 text-primary"></i>Medicine &amp; Batch Details</h2>
      </div>
      <div class="card-body p-4">
        <div class="row g-3">
          <div class="col-md-8">
            <label for="medicineName" class="form-label">Medicine name</label>
            <input class="form-control" id="medicineName" name="medicineName" maxlength="150" value="<%= form.medicineName || '' %>" placeholder="e.g. Paracetamol 500mg" required autofocus>
          </div>
          <div class="col-md-4">
            <label for="batchNumber" class="form-label">Batch number</label>
            <input class="form-control" id="batchNumber" name="batchNumber" maxlength="80" value="<%= form.batchNumber || '' %>" required>
          </div>
          <div class="col-md-4">
            <label for="expiryDate" class="form-label">Expiry date</label>
            <input class="form-control" type="date" id="expiryDate" name="expiryDate" value="<%= form.expiryDate || '' %>" required>
          </div>
          <div class="col-md-4">
            <label for="quantity" class="form-label">Quantity</label>
            <input class="form-control" type="number" id="quantity" name="quantity" min="0.01" step="0.01" value="<%= form.quantity || '' %>" required>
          </div>
          <div class="col-md-4">
            <label for="reference" class="form-label">Invoice/reference <span class="fw-normal text-secondary">(optional)</span></label>
            <input class="form-control" id="reference" name="reference" maxlength="100" value="<%= form.reference || '' %>">
          </div>
          <div class="col-md-6">
            <label for="purchasePrice" class="form-label">Purchase price per unit</label>
            <div class="input-group">
              <span class="input-group-text">Rs.</span>
              <input class="form-control" type="number" id="purchasePrice" name="purchasePrice" min="0" step="0.01" value="<%= form.purchasePrice || '' %>" required>
            </div>
          </div>
          <div class="col-md-6">
            <label for="retailPrice" class="form-label">Retail price per unit</label>
            <div class="input-group">
              <span class="input-group-text">Rs.</span>
              <input class="form-control" type="number" id="retailPrice" name="retailPrice" min="0" step="0.01" value="<%= form.retailPrice || '' %>" required>
            </div>
          </div>
        </div>
        <div class="alert alert-light border mt-4 mb-0 small text-secondary">
          If medicine name, batch number, and expiry match an existing batch, its quantity will increase and its latest prices will be saved.
        </div>
      </div>
      <div class="card-footer bg-white d-flex justify-content-end gap-2 p-3">
        <a href="/inventory" class="btn btn-outline-secondary">Cancel</a>
        <button class="btn btn-primary" type="submit"><i class="bi bi-plus-circle me-1"></i> Add Stock</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
