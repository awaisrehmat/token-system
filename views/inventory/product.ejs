<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div><span class="dashboard-eyebrow">Medicine master</span><h1 class="h3 mb-1"><%= product.name %></h1><p class="text-secondary mb-0">Batch inventory and complete stock-movement history</p></div>
  <a href="/inventory" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Inventory</a>
</div>

<% if (product.packagingStatus === 'CONFLICT') { %>
  <div class="alert alert-danger app-alert">
    <h2 class="h6"><i class="bi bi-exclamation-triangle me-1"></i> Packaging conflict</h2>
    <p class="small mb-3">Existing batches use different pack conversions. Select the correct definition below. Quantities remain in their recorded base units; no stock movement will be deleted.</p>
    <form action="/inventory/products/<%= product._id %>/resolve-packaging" method="post">
      <div class="row g-2 mb-3">
        <% batches.forEach((batch) => { %>
          <div class="col-md-6 col-xl-4"><label class="packaging-choice"><input type="radio" name="batchId" value="<%= batch._id %>" required><span><strong>Batch <%= batch.batchNumber %></strong><small>1 <%= batch.packUnit || 'Pack' %> = <%= batch.unitsPerPack || 1 %> <%= batch.looseUnit || 'Unit' %>(s) · Loose sale: <%= batch.allowLooseSale ? 'Yes' : 'No' %></small></span></label></div>
        <% }) %>
      </div>
      <button class="btn btn-danger" type="submit"><i class="bi bi-check2-circle me-1"></i> Use Selected Packaging</button>
    </form>
  </div>
<% } %>

<% if (product.pricingStatus === 'CONFLICT' && product.packagingStatus !== 'CONFLICT') { %>
  <div class="alert alert-warning app-alert">
    <h2 class="h6"><i class="bi bi-tags me-1"></i> Selling-price conflict</h2>
    <p class="small mb-3">Batches have different selling prices. Select the batch price you want to use for future sales. Purchase costs, quantities, and stock history will remain unchanged.</p>
    <form action="/inventory/products/<%= product._id %>/resolve-pricing" method="post">
      <div class="row g-2 mb-3">
        <% batches.forEach((batch) => { %>
          <div class="col-md-6 col-xl-4"><label class="packaging-choice"><input type="radio" name="batchId" value="<%= batch._id %>" required><span><strong>Batch <%= batch.batchNumber %></strong><small>Retail: Rs. <%= batch.retailPrice.toFixed(2) %> / <%= batch.packUnit %><% if (batch.allowLooseSale) { %> · Loose: Rs. <%= (batch.looseRetailPrice || 0).toFixed(2) %> / <%= batch.looseUnit %><% } %></small></span></label></div>
        <% }) %>
      </div>
      <button class="btn btn-warning" type="submit"><i class="bi bi-check2-circle me-1"></i> Use Selected Selling Price</button>
    </form>
  </div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card dashboard-kpi"><div class="card-body"><span class="dashboard-kpi-icon kpi-blue"><i class="bi bi-box-seam"></i></span><div><small>Total Base Stock</small><strong><%= totalQuantity.toLocaleString() %></strong><span><%= product.looseUnit %>(s)</span></div></div></div></div>
  <div class="col-md-4"><div class="card dashboard-kpi"><div class="card-body"><span class="dashboard-kpi-icon kpi-violet"><i class="bi bi-layers"></i></span><div><small>Batches</small><strong><%= batches.length %></strong><span>All expiry groups</span></div></div></div></div>
  <div class="col-md-4"><div class="card dashboard-kpi"><div class="card-body"><span class="dashboard-kpi-icon kpi-teal"><i class="bi bi-boxes"></i></span><div><small>Packaging</small><strong class="product-packaging-value"><%= product.unitsPerPack %></strong><span><%= product.looseUnit %>(s) per <%= product.packUnit %></span></div></div></div></div>
</div>

<div class="card app-card mb-4">
  <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Batch Stock</h2></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Batch</th><th>Expiry</th><th>Base Stock</th><th>Purchase / Pack</th><th>Retail / Pack</th><th>Loose Price</th><th>Status</th></tr></thead><tbody>
    <% batches.forEach((batch) => { const expired = batch.expiryDate < new Date(); const nearExpiry = !expired && batch.expiryDate <= new Date(Date.now() + 90 * 24 * 60 * 60 * 1000); %><tr><td class="font-monospace fw-semibold"><%= batch.batchNumber %></td><td><%= batch.expiryDate.toISOString().slice(0, 10) %> <% if (expired) { %><span class="badge text-bg-danger ms-1">Expired</span><% } else if (nearExpiry) { %><span class="badge text-bg-warning ms-1">Expiring soon</span><% } %></td><td><%= batch.quantity %> <%= batch.looseUnit || product.looseUnit %>(s)</td><td>Rs. <%= batch.purchasePrice.toFixed(2) %></td><td>Rs. <%= batch.retailPrice.toFixed(2) %></td><td><%= batch.allowLooseSale ? `Rs. ${(batch.looseRetailPrice || 0).toFixed(2)}` : 'Not allowed' %></td><td><span class="badge <%= expired ? 'text-bg-danger' : nearExpiry ? 'text-bg-warning' : batch.quantity > 0 ? 'text-bg-success' : 'text-bg-secondary' %>"><%= expired ? 'Expired' : nearExpiry ? 'Near expiry' : batch.quantity > 0 ? 'Available' : 'Empty' %></span></td></tr><% }) %>
  </tbody></table></div>
</div>

<div class="card app-card">
  <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Stock Movement History</h2></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Type</th><th>Batch</th><th>Expiry</th><th>Base Quantity</th><th>Reference</th><th>Remarks</th><th>User</th></tr></thead><tbody>
    <% if (!transactions.length) { %><tr><td colspan="8" class="text-center text-secondary py-5">No stock movements recorded.</td></tr><% } %>
    <% transactions.forEach((transaction) => { const historyExpiry = transaction.medicineBatch?.expiryDate; const historyExpired = historyExpiry && historyExpiry < new Date(); const historyNearExpiry = historyExpiry && !historyExpired && historyExpiry <= new Date(Date.now() + 90 * 24 * 60 * 60 * 1000); %><tr><td class="text-nowrap"><%= transaction.createdAt.toLocaleString('en-PK') %></td><td><span class="badge <%= transaction.type === 'IN' ? 'text-bg-success' : transaction.type === 'OUT' ? 'text-bg-primary' : 'text-bg-warning' %>"><%= transaction.type %></span></td><td><%= transaction.medicineBatch?.batchNumber || 'Deleted batch' %></td><td class="text-nowrap"><% if (historyExpiry) { %><%= historyExpiry.toISOString().slice(0, 10) %> <% if (historyExpired) { %><span class="badge text-bg-danger ms-1">Expired</span><% } else if (historyNearExpiry) { %><span class="badge text-bg-warning ms-1">Expiring soon</span><% } %><% } else { %>—<% } %></td><td class="fw-semibold"><%= transaction.type === 'OUT' ? '−' : '+' %><%= transaction.quantity %></td><td><%= transaction.reference || '—' %></td><td><%= transaction.remarks || '—' %></td><td><%= transaction.performedBy || '—' %></td></tr><% }) %>
  </tbody></table></div>
</div>

<%- include('../partials/footer') %>
