<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div><span class="dashboard-eyebrow">Stock correction</span><h1 class="h3 mb-1">Edit <%= product?.name || batch.medicineName %></h1><p class="text-secondary mb-0">Batch <%= batch.batchNumber %> — every change is recorded for administrators</p></div>
  <a href="/inventory/products/<%= batch.product %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Cancel</a>
</div>

<% if (errors.length) { %><div class="alert alert-danger app-alert"><ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
<% if (priceChange) { %><div class="alert alert-warning app-alert"><h2 class="h6"><i class="bi bi-exclamation-triangle me-1"></i>Confirm rate change</h2><p>Rates affect future sales. Please review and confirm:</p><ul class="mb-0"><% priceChange.forEach((change) => { %><li><%= change %></li><% }) %></ul></div><% } %>

<form method="post" action="/inventory/batches/<%= batch._id %>/edit" class="card app-card">
  <% if (priceChange) { %><input type="hidden" name="confirmRateChange" value="yes"><% } %>
  <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Batch Details</h2></div>
  <div class="card-body p-4"><div class="row g-3">
    <div class="col-md-6"><label class="form-label" for="batchNumber">Batch number</label><input class="form-control" id="batchNumber" name="batchNumber" maxlength="100" value="<%= form.batchNumber %>" required></div>
    <div class="col-md-6"><label class="form-label" for="expiryDate">Expiry date</label><input class="form-control" type="date" id="expiryDate" name="expiryDate" value="<%= form.expiryDate %>" required></div>
    <div class="col-md-6"><label class="form-label" for="quantity">Current quantity (<%= batch.looseUnit || 'base units' %>)</label><input class="form-control" type="number" id="quantity" name="quantity" min="0" step="1" value="<%= form.quantity %>" required><div class="form-text">Enter the actual total currently on hand. This replaces the displayed quantity; it does not add to it.</div></div>
    <div class="col-md-6"><label class="form-label" for="purchasePrice">Purchase price / <%= batch.packUnit %></label><div class="input-group"><span class="input-group-text">Rs.</span><input class="form-control" type="number" id="purchasePrice" name="purchasePrice" min="0" step="0.01" value="<%= form.purchasePrice %>" required></div></div>
    <div class="col-md-6"><label class="form-label" for="retailPrice">Retail price / <%= batch.packUnit %></label><div class="input-group"><span class="input-group-text">Rs.</span><input class="form-control" type="number" id="retailPrice" name="retailPrice" min="0" step="0.01" value="<%= form.retailPrice %>" required></div></div>
    <% if (batch.allowLooseSale) { %><div class="col-md-6"><label class="form-label" for="looseRetailPrice">Retail price / <%= batch.looseUnit %></label><div class="input-group"><span class="input-group-text">Rs.</span><input class="form-control" type="number" id="looseRetailPrice" name="looseRetailPrice" min="0" step="0.01" value="<%= form.looseRetailPrice %>" required></div></div><% } %>
    <div class="col-12"><label class="form-label" for="reason">Reason for change</label><textarea class="form-control" id="reason" name="reason" minlength="5" maxlength="500" rows="3" placeholder="Example: Physical count found 12 damaged units" required><%= form.reason %></textarea><div class="form-text">This explanation and all before/after values are saved in the audit history.</div></div>
  </div></div>
  <div class="card-footer bg-white d-flex justify-content-end gap-2 p-3"><a href="/inventory/products/<%= batch.product %>" class="btn btn-outline-secondary">Cancel</a><button class="btn <%= priceChange ? 'btn-warning' : 'btn-primary' %>" type="submit"><i class="bi bi-<%= priceChange ? 'exclamation-triangle' : 'check2-circle' %> me-1"></i><%= priceChange ? 'Confirm Rate Change & Save' : 'Review & Save Changes' %></button></div>
</form>

<%- include('../partials/footer') %>
