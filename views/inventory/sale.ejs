<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
  <div><h1 class="h4 mb-0">New Medicine Sale</h1></div>
  <a href="/inventory/sales" class="btn btn-outline-secondary"><i class="bi bi-receipt me-1"></i> Sales History</a>
</div>

<% if (errors.length) { %><div class="alert alert-danger app-alert"><ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
<% const selectedMrPatient = patients.find((patient) => patient._id === form.patientMr); %>

<% if (priceConflicts.length) { %>
  <details class="sale-conflict-panel mb-2">
    <summary><i class="bi bi-exclamation-triangle me-1"></i><strong><%= priceConflicts.length %> price conflict(s)</strong> <span>— click to resolve</span></summary>
    <div class="sale-conflict-body">
    <% priceConflicts.forEach(({ product, batches }) => { %>
      <div class="card border-warning mb-2"><div class="card-body py-2">
        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-2"><strong><%= product.name %></strong><a href="/inventory/products/<%= product._id %>" class="small">View complete history</a></div>
        <% if (product.packagingStatus === 'CONFLICT') { %>
          <p class="small text-danger mb-0">Resolve this product's packaging conflict first.</p>
        <% } else { %>
          <form action="/inventory/products/<%= product._id %>/resolve-pricing" method="post" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="hidden" name="returnTo" value="/inventory/sale">
            <div class="flex-grow-1"><label class="form-label small">Choose batch price</label><select class="form-select" name="batchId" required><option value="">Select batch and price</option><% batches.forEach((batch) => { %><option value="<%= batch._id %>">Batch <%= batch.batchNumber %> — Rs. <%= batch.retailPrice.toFixed(2) %> / <%= batch.packUnit %><% if (batch.allowLooseSale) { %> — Loose Rs. <%= (batch.looseRetailPrice || 0).toFixed(2) %><% } %></option><% }) %></select></div>
            <button class="btn btn-warning" type="submit"><i class="bi bi-check2-circle me-1"></i> Finalize Price</button>
          </form>
        <% } %>
      </div></div>
    <% }) %>
    </div>
  </details>
<% } %>

<form action="/inventory/sale" method="post" id="saleForm">
  <input type="hidden" name="saleRequestKey" value="<%= form.saleRequestKey || '' %>">
  <div class="alert alert-danger app-alert d-none" id="clientSaleError"><i class="bi bi-exclamation-circle-fill me-2"></i>Please correct the highlighted rows.</div>
  <div class="card app-card sale-sheet-card">
    <div class="sale-sheet-header">
      <div><span class="sale-sheet-kicker">Sales invoice</span><h2 class="h6 mb-0">Pack &amp; Loose Sale Sheet</h2></div>
      <div class="d-flex flex-wrap gap-2">
        <div class="sale-customer-field"><label for="patientMrSearch" class="form-label">Patient MR <small class="text-secondary">(optional)</small></label><div class="mr-combobox"><input type="hidden" id="patientMr" name="patientMr" value="<%= form.patientMr || '' %>"><input type="search" class="form-control" id="patientMrSearch" value="<%= selectedMrPatient ? `${selectedMrPatient._id} — ${selectedMrPatient.patientName}` : '' %>" placeholder="Type patient name or MR number" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="patientMrSuggestions"><div class="mr-suggestions d-none" id="patientMrSuggestions" role="listbox"><button type="button" class="mr-suggestion" data-mr="" data-patient-name="Walk-in customer" data-search="without mr walk-in customer" role="option"><strong>Without MR</strong><small>Walk-in customer</small></button><% patients.forEach((patient) => { %><button type="button" class="mr-suggestion" data-mr="<%= patient._id %>" data-patient-name="<%= patient.patientName %>" data-search="<%= `${patient._id} ${patient.patientName}`.toLowerCase() %>" role="option"><strong><%= patient._id %></strong><small><%= patient.patientName %></small></button><% }) %><div class="mr-no-results d-none">No matching patient found</div></div></div></div>
        <div class="sale-customer-field"><label for="customerName" class="form-label">Customer</label><input type="text" class="form-control" id="customerName" name="customerName" maxlength="100" value="<%= form.customerName || 'Walk-in customer' %>"></div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table sale-sheet-table sale-pack-table align-middle mb-0">
        <thead><tr><th class="sale-row-number">#</th><th>Medicine</th><th>Available Stock</th><th>Pack Qty</th><th>Loose Qty</th><th>Discount %</th><th class="text-end">Total</th></tr></thead>
        <tbody id="saleItems">
          <% Array.from({ length: Math.max(4, form.items.length) }, (_, index) => form.items[index] || {}).forEach((item, index) => { %>
            <tr class="sale-item-row">
              <td class="sale-row-number"><%= index + 1 %></td>
              <td>
                <div class="medicine-combobox"><input type="hidden" class="medicine-select" name="items[<%= index %>][medicineName]" value="<%= item.medicineName || '' %>"><input type="search" class="form-control medicine-search" value="<%= item.medicineName || '' %>" placeholder="Select medicine" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false"><div class="medicine-suggestions d-none" role="listbox"></div></div>
                <div class="invalid-feedback medicine-error"></div>
              </td>
              <td class="sale-stock-cell"><span>—</span><small></small></td>
              <td><div class="sale-unit-input"><input class="form-control pack-quantity-input" type="number" min="0" step="1" name="items[<%= index %>][packQuantity]" value="<%= item.packQuantity || '' %>" placeholder="0"><small class="pack-label">Pack</small></div><div class="invalid-feedback pack-error"></div></td>
              <td><div class="sale-unit-input"><input class="form-control loose-quantity-input" type="number" min="0" step="1" name="items[<%= index %>][looseQuantity]" value="<%= item.looseQuantity || '' %>" placeholder="0"><small class="loose-label">Unit</small></div><div class="invalid-feedback loose-error"></div></td>
              <td><input class="form-control discount-input" type="number" min="0" max="100" step="0.01" name="items[<%= index %>][discountPercent]" value="<%= item.discountPercent || '' %>" placeholder="0"><div class="invalid-feedback discount-error"></div></td>
              <td class="sale-line-total text-end">Rs. 0.00</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="sale-add-row"><button type="button" class="btn btn-outline-primary btn-sm" id="addSaleItem"><i class="bi bi-plus-lg me-1"></i> Add Item</button></div>
    <div class="sale-sheet-footer"><p class="text-secondary small mb-0"><i class="bi bi-arrow-down-up me-1"></i>FEFO batch deduction; stock is stored in loose/base units.</p><div class="sale-summary"><span>Grand Total</span><strong id="grandTotal">Rs. 0.00</strong></div><button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Complete Sale</button></div>
  </div>
</form>

<datalist id="medicineSuggestions">
  <% medicines.forEach((medicine) => { %><option value="<%= medicine._id %>" data-stock="<%= medicine.availableQuantity %>" data-pack-price="<%= medicine.retailPrice %>" data-loose-price="<%= medicine.looseRetailPrice || medicine.retailPrice / (medicine.unitsPerPack || 1) %>" data-pack-unit="<%= medicine.packUnit || 'Pack' %>" data-loose-unit="<%= medicine.looseUnit || 'Unit' %>" data-units="<%= medicine.unitsPerPack || 1 %>" data-loose-allowed="<%= medicine.allowLooseSale ? 'true' : 'false' %>"></option><% }) %>
</datalist>

<template id="saleRowTemplate">
  <tr class="sale-item-row"><td class="sale-row-number"></td><td><div class="medicine-combobox"><input type="hidden" class="medicine-select"><input type="search" class="form-control medicine-search" placeholder="Select medicine" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false"><div class="medicine-suggestions d-none" role="listbox"></div></div><div class="invalid-feedback medicine-error"></div></td><td class="sale-stock-cell"><span>—</span><small></small></td><td><div class="sale-unit-input"><input class="form-control pack-quantity-input" type="number" min="0" step="1" placeholder="0"><small class="pack-label">Pack</small></div><div class="invalid-feedback pack-error"></div></td><td><div class="sale-unit-input"><input class="form-control loose-quantity-input" type="number" min="0" step="1" placeholder="0"><small class="loose-label">Unit</small></div><div class="invalid-feedback loose-error"></div></td><td><input class="form-control discount-input" type="number" min="0" max="100" step="0.01" placeholder="0"><div class="invalid-feedback discount-error"></div></td><td class="sale-line-total text-end">Rs. 0.00</td></tr>
</template>

<script>
  const saleForm = document.getElementById('saleForm');
  const patientMr = document.getElementById('patientMr');
  const patientMrSearch = document.getElementById('patientMrSearch');
  const patientMrSuggestions = document.getElementById('patientMrSuggestions');
  const customerName = document.getElementById('customerName');
  const saleItems = document.getElementById('saleItems');
  const clientSaleError = document.getElementById('clientSaleError');
  const medicineOptions = new Map([...document.querySelectorAll('#medicineSuggestions option')].map((option) => [option.value.trim().toLowerCase(), option]));
  function closeMedicineMenus(except = null) {
    document.querySelectorAll('.medicine-combobox').forEach((box) => {
      if (box === except) return;
      box.querySelector('.medicine-suggestions').classList.add('d-none');
      box.querySelector('.medicine-search').setAttribute('aria-expanded', 'false');
    });
  }
  function showMedicineMenu(box) {
    const search = box.querySelector('.medicine-search');
    const menu = box.querySelector('.medicine-suggestions');
    const query = search.value.trim().toLowerCase();
    menu.replaceChildren();
    const matches = [...medicineOptions.values()].filter((option) => !query || option.value.toLowerCase().includes(query)).slice(0, 50);
    matches.forEach((option) => {
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'medicine-suggestion'; button.setAttribute('role', 'option');
      const name = document.createElement('strong'); name.textContent = option.value;
      const detail = document.createElement('small'); detail.textContent = `${option.dataset.stock} ${option.dataset.looseUnit} available · Rs. ${Number(option.dataset.packPrice).toFixed(2)} / ${option.dataset.packUnit}`;
      button.append(name, detail);
      button.addEventListener('click', () => { box.querySelector('.medicine-select').value = option.value; search.value = option.value; menu.classList.add('d-none'); search.setAttribute('aria-expanded', 'false'); refreshSheet(); });
      menu.appendChild(button);
    });
    if (!matches.length) { const empty = document.createElement('div'); empty.className = 'medicine-no-results'; empty.textContent = 'No matching medicine found'; menu.appendChild(empty); }
    closeMedicineMenus(box); menu.classList.remove('d-none'); search.setAttribute('aria-expanded', 'true');
  }
  const mrOptions = [...patientMrSuggestions.querySelectorAll('.mr-suggestion')];
  const showMrSuggestions = () => { patientMrSuggestions.classList.remove('d-none'); patientMrSearch.setAttribute('aria-expanded', 'true'); };
  const hideMrSuggestions = () => { patientMrSuggestions.classList.add('d-none'); patientMrSearch.setAttribute('aria-expanded', 'false'); };
  function filterMrSuggestions() {
    const query = patientMr.value ? '' : patientMrSearch.value.trim().toLowerCase();
    let matches = 0;
    mrOptions.forEach((option) => { const visible = !query || option.dataset.search.includes(query); option.classList.toggle('d-none', !visible); if (visible) matches += 1; });
    patientMrSuggestions.querySelector('.mr-no-results').classList.toggle('d-none', matches > 0);
    showMrSuggestions();
  }
  patientMrSearch.addEventListener('focus', filterMrSuggestions);
  patientMrSearch.addEventListener('input', () => { patientMr.value = ''; customerName.value = 'Walk-in customer'; filterMrSuggestions(); });
  patientMrSearch.addEventListener('keydown', (event) => { if (event.key === 'Escape') hideMrSuggestions(); if (event.key === 'Enter') { const first = mrOptions.find((option) => !option.classList.contains('d-none')); if (first) { event.preventDefault(); first.click(); } } });
  mrOptions.forEach((option) => option.addEventListener('click', () => { patientMr.value = option.dataset.mr; customerName.value = option.dataset.patientName || 'Walk-in customer'; patientMrSearch.value = option.dataset.mr ? `${option.dataset.mr} — ${option.dataset.patientName}` : ''; hideMrSuggestions(); }));
  document.addEventListener('click', (event) => { if (!event.target.closest('.mr-combobox')) hideMrSuggestions(); });
  function errorFor(field, feedback, message) { field.classList.toggle('is-invalid', Boolean(message)); field.setCustomValidity(message); feedback.textContent = message; }
  function refreshSheet() {
    const rows = [...saleItems.querySelectorAll('.sale-item-row')];
    const selected = rows.map((row) => row.querySelector('.medicine-select').value).filter(Boolean);
    let grand = 0; let invalid = false;
    rows.forEach((row, index) => {
      const medicine = row.querySelector('.medicine-select'); const medicineSearch = row.querySelector('.medicine-search'); const option = medicineOptions.get(medicine.value.trim().toLowerCase());
      const packInput = row.querySelector('.pack-quantity-input'); const looseInput = row.querySelector('.loose-quantity-input'); const discountInput = row.querySelector('.discount-input');
      medicine.name = `items[${index}][medicineName]`; packInput.name = `items[${index}][packQuantity]`; looseInput.name = `items[${index}][looseQuantity]`; discountInput.name = `items[${index}][discountPercent]`; row.querySelector('.sale-row-number').textContent = index + 1;
      const packs = Number(packInput.value || 0); const loose = Number(looseInput.value || 0); const discount = Number(discountInput.value || 0); const units = Number(option?.dataset.units || 1); const stock = Number(option?.dataset.stock || 0); const packPrice = Number(option?.dataset.packPrice || 0); const loosePrice = Number(option?.dataset.loosePrice || 0); const looseAllowed = option?.dataset.looseAllowed === 'true'; const started = Boolean(medicineSearch.value || packInput.value || looseInput.value || discountInput.value);
      let medicineError = ''; let packError = ''; let looseError = ''; let discountError = '';
      if (medicine.value && !option) medicineError = 'Choose a medicine from the list.'; else if (medicine.value && selected.filter((value) => value.toLowerCase() === medicine.value.toLowerCase()).length > 1) medicineError = 'Medicine already selected.'; else if (started && !medicine.value) medicineError = 'Select a medicine.';
      if ((packInput.value && (!Number.isInteger(packs) || packs < 0))) packError = 'Use a whole number.';
      if ((looseInput.value && (!Number.isInteger(loose) || loose < 0))) looseError = 'Use a whole number.'; else if (loose > 0 && !looseAllowed) looseError = 'Loose sale is disabled.';
      if (medicine.value && packs * units + loose > stock) looseError = `Only ${stock} base units available.`;
      if (started && packs + loose <= 0) packError = 'Enter pack or loose quantity.';
      if (discountInput.value && (discount < 0 || discount > 100)) discountError = 'Use 0 to 100.';
      errorFor(medicineSearch, row.querySelector('.medicine-error'), medicineError); errorFor(packInput, row.querySelector('.pack-error'), packError); errorFor(looseInput, row.querySelector('.loose-error'), looseError); errorFor(discountInput, row.querySelector('.discount-error'), discountError);
      looseInput.disabled = Boolean(option && !looseAllowed); row.querySelector('.pack-label').textContent = option?.dataset.packUnit || 'Pack'; row.querySelector('.loose-label').textContent = option?.dataset.looseUnit || 'Unit';
      const stockCell = row.querySelector('.sale-stock-cell'); if (option) { const fullPacks = Math.floor(stock / units); const remainder = stock % units; stockCell.querySelector('span').textContent = `${fullPacks} ${option.dataset.packUnit}`; stockCell.querySelector('small').textContent = `+ ${remainder} ${option.dataset.looseUnit}`; } else { stockCell.querySelector('span').textContent = '—'; stockCell.querySelector('small').textContent = ''; }
      const total = Math.max(0, (packs * packPrice + loose * loosePrice) * (1 - discount / 100)); row.querySelector('.sale-line-total').textContent = `Rs. ${total.toFixed(2)}`; row.classList.toggle('sale-row-active', Boolean(medicine.value)); grand += total; invalid ||= Boolean(medicineError || packError || looseError || discountError);
    });
    document.getElementById('grandTotal').textContent = `Rs. ${grand.toFixed(2)}`; return invalid;
  }
  saleItems.addEventListener('input', refreshSheet); saleItems.addEventListener('change', refreshSheet);
  saleItems.addEventListener('focusin', (event) => { if (event.target.matches('.medicine-search')) showMedicineMenu(event.target.closest('.medicine-combobox')); });
  saleItems.addEventListener('input', (event) => { if (event.target.matches('.medicine-search')) { event.target.closest('.medicine-combobox').querySelector('.medicine-select').value = ''; showMedicineMenu(event.target.closest('.medicine-combobox')); refreshSheet(); } });
  saleItems.addEventListener('keydown', (event) => { if (!event.target.matches('.medicine-search')) return; const menu = event.target.closest('.medicine-combobox').querySelector('.medicine-suggestions'); if (event.key === 'Escape') closeMedicineMenus(); if (event.key === 'Enter') { const first = menu.querySelector('.medicine-suggestion'); if (first) { event.preventDefault(); first.click(); } } });
  document.addEventListener('click', (event) => { if (!event.target.closest('.medicine-combobox')) closeMedicineMenus(); });
  document.getElementById('addSaleItem').addEventListener('click', () => { saleItems.appendChild(document.getElementById('saleRowTemplate').content.cloneNode(true)); refreshSheet(); saleItems.querySelector('.sale-item-row:last-child .medicine-search').focus(); });
  saleForm.addEventListener('submit', (event) => { const hasMedicine = [...saleItems.querySelectorAll('.medicine-select')].some((field) => field.value); if (!hasMedicine || refreshSheet()) { event.preventDefault(); clientSaleError.classList.remove('d-none'); saleForm.querySelector('.is-invalid')?.focus(); } else clientSaleError.classList.add('d-none'); });
  refreshSheet();
</script>

<%- include('../partials/footer') %>
