<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">New Medicine Sale</h1>
    <p class="text-secondary mb-0">Enter medicines in the sheet below; empty rows are ignored</p>
  </div>
  <a href="/inventory/sales" class="btn btn-outline-secondary">
    <i class="bi bi-receipt me-1"></i> Sales History
  </a>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger app-alert">
    <ul class="mb-0">
      <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
    </ul>
  </div>
<% } %>

<form action="/inventory/sale" method="post" id="saleForm">
  <div class="alert alert-danger app-alert d-none" id="clientSaleError" role="alert">
    <i class="bi bi-exclamation-circle-fill me-2"></i>
    Please correct the highlighted sale rows before continuing.
  </div>
  <div class="card app-card sale-sheet-card">
    <div class="sale-sheet-header">
      <div>
        <span class="sale-sheet-kicker">Sales invoice</span>
        <h2 class="h5 mb-0">Medicine Entry Sheet</h2>
      </div>
      <div class="sale-customer-field">
        <label for="customerName" class="form-label">Customer</label>
        <input
          type="text"
          class="form-control"
          id="customerName"
          name="customerName"
          maxlength="100"
          value="<%= form.customerName || '' %>"
          placeholder="Walk-in customer"
        >
      </div>
    </div>

    <div class="table-responsive">
      <table class="table sale-sheet-table align-middle mb-0">
        <thead>
          <tr>
            <th class="sale-row-number">#</th>
            <th>Medicine</th>
            <th class="text-end">Available</th>
            <th class="text-end">Retail Price</th>
            <th>Quantity</th>
            <th>Discount %</th>
            <th class="text-end">Line Total</th>
          </tr>
        </thead>
        <tbody id="saleItems">
          <% Array.from({ length: Math.max(8, form.items.length) }, (_, index) => form.items[index] || {}).forEach((item, index) => { %>
            <tr class="sale-item-row">
              <td class="sale-row-number"><%= index + 1 %></td>
              <td>
                <select class="form-select medicine-select" name="items[<%= index %>][medicineName]">
                  <option value="">Select medicine</option>
                  <% medicines.forEach((medicine) => { %>
                    <option
                      value="<%= medicine._id %>"
                      data-price="<%= medicine.retailPrice %>"
                      data-stock="<%= medicine.availableQuantity %>"
                      <%= item.medicineName === medicine._id ? 'selected' : '' %>
                    ><%= medicine._id %></option>
                  <% }) %>
                </select>
                <div class="invalid-feedback medicine-error"></div>
              </td>
              <td class="sale-stock-cell text-end">—</td>
              <td class="sale-price-cell text-end">—</td>
              <td>
                <input
                  class="form-control quantity-input"
                  type="number"
                  min="0.01"
                  step="0.01"
                  name="items[<%= index %>][quantity]"
                  value="<%= item.quantity || '' %>"
                  placeholder="0"
                >
                <div class="invalid-feedback quantity-error"></div>
              </td>
              <td>
                <input
                  class="form-control discount-input"
                  type="number"
                  min="0"
                  max="100"
                  step="0.01"
                  name="items[<%= index %>][discountPercent]"
                  value="<%= item.discountPercent || '' %>"
                  placeholder="0"
                >
                <div class="invalid-feedback discount-error"></div>
              </td>
              <td class="sale-line-total text-end">Rs. 0.00</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="sale-sheet-footer">
      <p class="text-secondary small mb-0">
        <i class="bi bi-arrow-down-up me-1"></i> Stock is issued from the earliest-expiring batch.
      </p>
      <div class="sale-summary">
        <span>Grand Total</span>
        <strong id="grandTotal">Rs. 0.00</strong>
      </div>
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-check2-circle me-1"></i> Complete Sale
      </button>
    </div>
  </div>
</form>

<script>
  const saleForm = document.getElementById('saleForm');
  const rows = [...document.querySelectorAll('.sale-item-row')];
  const clientSaleError = document.getElementById('clientSaleError');

  function setFieldError(field, message, feedback) {
    field.classList.toggle('is-invalid', Boolean(message));
    field.setCustomValidity(message);
    feedback.textContent = message;
  }

  function refreshSheet(showEmptyErrors = false) {
    let grandTotal = 0;
    let hasErrors = false;

    const selectedMedicines = rows
      .map((row) => row.querySelector('.medicine-select').value)
      .filter(Boolean);

    rows.forEach((row) => {
      const medicineSelect = row.querySelector('.medicine-select');
      const quantityInput = row.querySelector('.quantity-input');
      const discountInput = row.querySelector('.discount-input');
      const option = medicineSelect.selectedOptions[0];
      const price = Number(option?.dataset.price || 0);
      const stock = Number(option?.dataset.stock || 0);
      const quantityText = quantityInput.value.trim();
      const discountText = discountInput.value.trim();
      const quantity = Number(quantityText || 0);
      const discount = Number(discountText || 0);
      const rowStarted = Boolean(medicineSelect.value || quantityText || discountText);
      const duplicate = medicineSelect.value &&
        selectedMedicines.filter((name) => name === medicineSelect.value).length > 1;

      let medicineError = '';
      let quantityError = '';
      let discountError = '';

      if (duplicate) medicineError = 'This medicine is already selected in another row.';
      else if (rowStarted && !medicineSelect.value) medicineError = 'Select a medicine.';

      if (rowStarted && !quantityText) quantityError = 'Enter a quantity.';
      else if (quantityText && (!Number.isFinite(quantity) || quantity <= 0)) {
        quantityError = 'Quantity must be greater than zero.';
      } else if (medicineSelect.value && quantity > stock) {
        quantityError = `Only ${stock} available.`;
      }

      if (discountText && (!Number.isFinite(discount) || discount < 0 || discount > 100)) {
        discountError = 'Use a discount from 0 to 100.';
      }

      if (!showEmptyErrors && !rowStarted) {
        medicineError = '';
        quantityError = '';
        discountError = '';
      }

      setFieldError(medicineSelect, medicineError, row.querySelector('.medicine-error'));
      setFieldError(quantityInput, quantityError, row.querySelector('.quantity-error'));
      setFieldError(discountInput, discountError, row.querySelector('.discount-error'));
      quantityInput.max = medicineSelect.value ? stock : '';

      const total = Math.max(0, quantity * price * (1 - discount / 100));

      row.querySelector('.sale-stock-cell').textContent = option?.value ? stock : '—';
      row.querySelector('.sale-price-cell').textContent = option?.value ? `Rs. ${price.toFixed(2)}` : '—';
      row.querySelector('.sale-line-total').textContent = `Rs. ${total.toFixed(2)}`;
      row.classList.toggle('sale-row-active', Boolean(option?.value));
      grandTotal += total;
      hasErrors = hasErrors || Boolean(medicineError || quantityError || discountError);
    });

    rows.forEach((row) => {
      const ownValue = row.querySelector('.medicine-select').value;
      row.querySelectorAll('.medicine-select option').forEach((option) => {
        if (!option.value) return;
        option.disabled = option.value !== ownValue && selectedMedicines.includes(option.value);
      });
    });

    document.getElementById('grandTotal').textContent = `Rs. ${grandTotal.toFixed(2)}`;
    return hasErrors;
  }

  document.getElementById('saleItems').addEventListener('input', () => refreshSheet());
  document.getElementById('saleItems').addEventListener('change', () => refreshSheet());
  saleForm.addEventListener('submit', (event) => {
    const hasMedicine = rows.some((row) => row.querySelector('.medicine-select').value);
    const hasErrors = refreshSheet(true);

    if (!hasMedicine || hasErrors) {
      event.preventDefault();
      clientSaleError.classList.remove('d-none');
      const firstInvalid = saleForm.querySelector('.is-invalid');
      firstInvalid?.focus();
    } else {
      clientSaleError.classList.add('d-none');
    }
  });
  refreshSheet();
</script>

<%- include('../partials/footer') %>
