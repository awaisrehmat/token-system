<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Medicine Sales</h1>
    <p class="text-secondary mb-0">Completed sales and inventory-out records</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/inventory" class="btn btn-outline-secondary">
      <i class="bi bi-box-seam me-1"></i> Inventory
    </a>
    <a href="/inventory/sale" class="btn btn-primary">
      <i class="bi bi-cart-plus me-1"></i> New Sale
    </a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card metric-card metric-card-patients h-100">
      <div class="card-body">
        <p class="metric-label mb-2">Total Sales</p>
        <p class="metric-value mb-0"><%= summary.count.toLocaleString() %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card metric-card-token h-100">
      <div class="card-body">
        <p class="metric-label mb-2">Sale Amount</p>
        <p class="metric-value inventory-metric-value mb-0">Rs. <%= summary.amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card metric-card-discount h-100">
      <div class="card-body">
        <p class="metric-label mb-2">Discount Given</p>
        <p class="metric-value inventory-metric-value mb-0">Rs. <%= summary.discount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
      </div>
    </div>
  </div>
</div>

<div class="card app-card">
  <div class="card-header bg-white py-3">
    <form method="get" action="/inventory/sales" class="d-flex flex-wrap gap-2">
      <div class="input-group inventory-search">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input
          type="search"
          class="form-control"
          name="search"
          value="<%= search %>"
          placeholder="Invoice, customer, or medicine"
          aria-label="Search sales"
        >
      </div>
      <button class="btn btn-outline-primary" type="submit">Search</button>
      <% if (search) { %><a href="/inventory/sales" class="btn btn-outline-secondary">Clear</a><% } %>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Invoice</th>
          <th>Customer</th>
          <th>Medicines</th>
          <th class="text-end">Quantity</th>
          <th class="text-end">Subtotal</th>
          <th class="text-end">Discount</th>
          <th class="text-end">Total</th>
          <th>Sold By</th>
        </tr>
      </thead>
      <tbody>
        <% if (!sales.length) { %>
          <tr>
            <td colspan="9" class="text-center text-secondary py-5">
              <i class="bi bi-receipt d-block fs-2 mb-2"></i>
              <%= search ? 'No matching sales found.' : 'No sales recorded yet.' %>
            </td>
          </tr>
        <% } %>

        <% sales.forEach((sale) => {
          const totalQuantity = sale.items.reduce((sum, item) => sum + item.quantity, 0);
        %>
          <tr>
            <td class="text-nowrap"><%= sale.createdAt.toLocaleString('en-PK') %></td>
            <td class="font-monospace fw-semibold"><%= sale.invoiceNumber %></td>
            <td><%= sale.customerName %></td>
            <td>
              <% sale.items.forEach((item) => { %>
                <div><%= item.medicineName %> <span class="text-secondary">× <%= item.quantity %></span></div>
              <% }) %>
            </td>
            <td class="text-end fw-semibold"><%= totalQuantity.toLocaleString() %></td>
            <td class="text-end text-nowrap">Rs. <%= sale.subtotal.toFixed(2) %></td>
            <td class="text-end text-nowrap">Rs. <%= sale.discountAmount.toFixed(2) %></td>
            <td class="text-end text-nowrap fw-bold">Rs. <%= sale.grandTotal.toFixed(2) %></td>
            <td><%= sale.performedBy || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
