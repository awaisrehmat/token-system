<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Medicine Sales</h1>
    <p class="text-secondary mb-0">Completed sales and inventory-out records</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/inventory" class="btn btn-outline-secondary"><i class="bi bi-box-seam me-1"></i> Inventory</a>
    <a href="/inventory/sale" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i> New Sale</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card metric-card metric-card-patients h-100"><div class="card-body">
      <p class="metric-label mb-2">Total Sales</p><p class="metric-value mb-0"><%= summary.count.toLocaleString() %></p>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card metric-card-token h-100"><div class="card-body">
      <p class="metric-label mb-2">Sale Amount</p><p class="metric-value inventory-metric-value mb-0">Rs. <%= summary.amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card metric-card-discount h-100"><div class="card-body">
      <p class="metric-label mb-2">Discount Given</p><p class="metric-value inventory-metric-value mb-0">Rs. <%= summary.discount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
    </div></div>
  </div>
</div>

<div class="card app-card">
  <div class="card-header bg-white py-3">
    <form method="get" action="/inventory/sales" class="filter-bar">
      <div class="input-group inventory-search">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="search" class="form-control" name="search" value="<%= search %>" placeholder="Invoice, customer, or medicine" aria-label="Search sales">
      </div>
      <input class="form-control filter-date" type="date" name="dateFrom" value="<%= dateFrom %>" aria-label="From date" title="From date">
      <input class="form-control filter-date" type="date" name="dateTo" value="<%= dateTo %>" aria-label="To date" title="To date">
      <select class="form-select filter-select" name="status" aria-label="Sale status">
        <option value="">All statuses</option>
        <option value="active" <%= status === 'active' ? 'selected' : '' %>>Completed</option>
        <option value="void" <%= status === 'void' ? 'selected' : '' %>>Deleted</option>
      </select>
      <select class="form-select filter-select" name="soldBy" aria-label="Sold by">
        <option value="">All staff</option>
        <% salespeople.forEach((person) => { %><option value="<%= person %>" <%= soldBy === person ? 'selected' : '' %>><%= person %></option><% }) %>
      </select>
      <button class="btn btn-outline-primary" type="submit"><i class="bi bi-funnel me-1"></i> Filter</button>
      <% if (search || dateFrom || dateTo || status || soldBy) { %><a href="/inventory/sales" class="btn btn-outline-secondary">Clear</a><% } %>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Date</th><th>Invoice</th><th>Customer</th><th>Items</th><th class="text-end">Quantity</th><th class="text-end">Total</th><th>Status</th><th class="text-end">Actions</th></tr>
      </thead>
      <tbody>
        <% if (!sales.length) { %>
          <tr><td colspan="8" class="text-center text-secondary py-5"><i class="bi bi-receipt d-block fs-2 mb-2"></i><%= search ? 'No matching sales found.' : 'No sales recorded yet.' %></td></tr>
        <% } %>
        <% sales.forEach((sale) => {
          const totalQuantity = sale.items.reduce((sum, item) => sum + item.quantity, 0);
        %>
          <tr>
            <td class="text-nowrap"><%= sale.createdAt.toLocaleString('en-PK') %></td>
            <td class="font-monospace fw-semibold"><%= sale.invoiceNumber %></td>
            <td><%= sale.customerName %><% if (sale.patientMr) { %><small class="d-block text-primary fw-semibold"><%= sale.patientMr %></small><% } else { %><small class="d-block text-secondary">Walk-in</small><% } %></td>
            <td><%= sale.items.length %></td>
            <td class="text-end fw-semibold"><%= totalQuantity.toLocaleString() %></td>
            <td class="text-end text-nowrap fw-bold <%= sale.status === 'VOID' ? 'text-decoration-line-through text-secondary' : '' %>">Rs. <%= sale.grandTotal.toFixed(2) %></td>
            <td><span class="badge <%= sale.status === 'VOID' ? 'text-bg-secondary' : 'text-bg-success' %>"><%= sale.status === 'VOID' ? 'Deleted' : 'Completed' %></span></td>
            <td class="text-end">
              <div class="d-inline-flex gap-1">
                <button class="btn btn-outline-primary btn-action" type="button" data-bs-toggle="modal" data-bs-target="#saleModal<%= sale._id %>" title="View details"><i class="bi bi-eye"></i></button>
                <a href="/inventory/sales/<%= sale._id %>/bill" class="btn btn-outline-secondary btn-action" title="View bill"><i class="bi bi-receipt-cutoff"></i></a>
                <% if (sale.status !== 'VOID') { %>
                  <form action="/inventory/sales/<%= sale._id %>/delete" method="post" class="delete-form">
                    <button class="btn btn-outline-danger btn-action" type="submit" title="Delete sale"><i class="bi bi-trash"></i></button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% sales.forEach((sale) => { %>
  <div class="modal fade" id="saleModal<%= sale._id %>" tabindex="-1" aria-labelledby="saleModalLabel<%= sale._id %>" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content sale-detail-modal">
        <div class="modal-header">
          <div><span class="sale-sheet-kicker">Sale details</span><h2 class="modal-title fs-5" id="saleModalLabel<%= sale._id %>"><%= sale.invoiceNumber %></h2></div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <% if (sale.status === 'VOID') { %>
            <div class="alert alert-secondary">This sale was deleted on <%= sale.voidedAt ? sale.voidedAt.toLocaleString('en-PK') : 'an unknown date' %><% if (sale.voidedBy) { %> by <strong><%= sale.voidedBy %></strong><% } %>. Its stock was restored.</div>
          <% } %>
          <div class="sale-detail-meta">
            <div><span>Customer</span><strong><%= sale.customerName %></strong></div>
            <div><span>Patient MR</span><strong><%= sale.patientMr || 'Walk-in sale' %></strong></div>
            <div><span>Sale date</span><strong><%= sale.createdAt.toLocaleString('en-PK') %></strong></div>
            <div><span>Sold by</span><strong><%= sale.performedBy || '—' %></strong></div>
            <div><span>Status</span><strong><%= sale.status === 'VOID' ? 'Deleted' : 'Completed' %></strong></div>
          </div>
          <div class="table-responsive mt-4">
            <table class="table align-middle sale-detail-table">
              <thead class="table-light"><tr><th>Medicine / Batch</th><th class="text-end">Qty</th><th class="text-end">Subtotal</th><th class="text-end">Discount</th><th class="text-end">Total</th></tr></thead>
              <tbody>
                <% sale.items.forEach((item) => { %>
                  <tr>
                    <td>
                      <strong><%= item.medicineName %></strong>
                      <% item.allocations.forEach((allocation) => { %><div class="small text-secondary">Batch <%= allocation.batchNumber %> &middot; <%= allocation.quantity %> base unit(s)</div><% }) %>
                    </td>
                    <td class="text-end"><% if (item.baseQuantity) { %><%= item.packQuantity %> <%= item.packUnit %><% if (item.looseQuantity) { %><div class="small text-secondary">+ <%= item.looseQuantity %> <%= item.looseUnit %></div><% } %><% } else { %><%= item.quantity %><% } %></td>
                    <td class="text-end">Rs. <%= item.subtotal.toFixed(2) %></td>
                    <td class="text-end"><%= item.discountPercent %>%<div class="small text-secondary">Rs. <%= item.discountAmount.toFixed(2) %></div></td>
                    <td class="text-end fw-bold">Rs. <%= item.total.toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="sale-detail-totals">
            <div><span>Subtotal</span><strong>Rs. <%= sale.subtotal.toFixed(2) %></strong></div>
            <div><span>Discount</span><strong>Rs. <%= sale.discountAmount.toFixed(2) %></strong></div>
            <div class="grand"><span>Grand Total</span><strong>Rs. <%= sale.grandTotal.toFixed(2) %></strong></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
          <a href="/inventory/sales/<%= sale._id %>/bill" class="btn btn-primary"><i class="bi bi-printer me-1"></i> View Bill</a>
        </div>
      </div>
    </div>
  </div>
<% }) %>

<%- include('../partials/footer') %>
