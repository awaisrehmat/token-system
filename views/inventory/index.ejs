<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Medicine Inventory</h1>
    <p class="text-secondary mb-0">Current stock by medicine and batch</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/inventory/sales" class="btn btn-outline-secondary">
      <i class="bi bi-receipt me-1"></i> Sales
    </a>
    <a href="/inventory/sale" class="btn btn-primary">
      <i class="bi bi-cart-plus me-1"></i> New Sale
    </a>
    <a href="/inventory/add" class="btn btn-outline-primary">
      <i class="bi bi-plus-circle me-1"></i> Add Stock
    </a>
    <a href="/inventory/upload" class="btn btn-outline-primary">
      <i class="bi bi-cloud-arrow-up me-1"></i> Upload Medicines
    </a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card metric-card metric-card-patients h-100">
      <div class="card-body">
        <p class="metric-label mb-2">Total Quantity</p>
        <p class="metric-value mb-0"><%= summary.quantity.toLocaleString() %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card metric-card-token h-100">
      <div class="card-body">
        <p class="metric-label mb-2">Stock Cost Value</p>
        <p class="metric-value inventory-metric-value mb-0">Rs. <%= summary.stockValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card metric-card-expiry h-100">
      <div class="card-body">
        <p class="metric-label mb-2">Expired Batches</p>
        <p class="metric-value mb-0"><%= summary.expired %></p>
      </div>
    </div>
  </div>
</div>

<div class="card app-card">
  <div class="card-header bg-white py-3">
    <form method="get" action="/inventory" class="filter-bar">
      <div class="input-group inventory-search">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input
          type="search"
          class="form-control"
          name="search"
          value="<%= search %>"
          placeholder="Search medicine or batch"
          aria-label="Search medicine or batch"
        >
      </div>
      <select class="form-select filter-select" name="stockStatus" aria-label="Stock status">
        <option value="">All stock</option>
        <option value="in_stock" <%= stockStatus === 'in_stock' ? 'selected' : '' %>>In stock</option>
        <option value="out_of_stock" <%= stockStatus === 'out_of_stock' ? 'selected' : '' %>>Out of stock</option>
      </select>
      <select class="form-select filter-select" name="expiryStatus" aria-label="Expiry status">
        <option value="">All expiry</option>
        <option value="valid" <%= expiryStatus === 'valid' ? 'selected' : '' %>>Valid (90+ days)</option>
        <option value="near_expiry" <%= expiryStatus === 'near_expiry' ? 'selected' : '' %>>Near expiry</option>
        <option value="expired" <%= expiryStatus === 'expired' ? 'selected' : '' %>>Expired</option>
      </select>
      <select class="form-select filter-select" name="sort" aria-label="Sort inventory">
        <option value="medicine" <%= sort === 'medicine' ? 'selected' : '' %>>Medicine A–Z</option>
        <option value="expiry" <%= sort === 'expiry' ? 'selected' : '' %>>Expiry first</option>
        <option value="quantity_high" <%= sort === 'quantity_high' ? 'selected' : '' %>>Quantity: high to low</option>
        <option value="quantity_low" <%= sort === 'quantity_low' ? 'selected' : '' %>>Quantity: low to high</option>
        <option value="retail_high" <%= sort === 'retail_high' ? 'selected' : '' %>>Retail price: high to low</option>
        <option value="retail_low" <%= sort === 'retail_low' ? 'selected' : '' %>>Retail price: low to high</option>
      </select>
      <button class="btn btn-outline-primary" type="submit">Search</button>
      <% if (search || stockStatus || expiryStatus || sort !== 'medicine') { %>
        <a href="/inventory" class="btn btn-outline-secondary">Clear</a>
      <% } %>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Medicine</th>
          <th>Batch</th>
          <th>Expiry</th>
          <th class="text-end">Quantity</th>
          <th class="text-end">Purchase Price</th>
          <th class="text-end">Retail Price</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!batches.length) { %>
          <tr>
            <td colspan="7" class="text-center text-secondary py-5">
              <i class="bi bi-capsule d-block fs-2 mb-2"></i>
              <%= search ? 'No matching medicine batches found.' : 'No medicines uploaded yet.' %>
            </td>
          </tr>
        <% } %>

        <% batches.forEach((batch) => {
          const expired = batch.expiryDate < new Date();
          const nearExpiry = !expired && batch.expiryDate <= new Date(Date.now() + 90 * 24 * 60 * 60 * 1000);
        %>
          <tr>
            <td class="fw-semibold"><%= batch.medicineName %></td>
            <td><span class="font-monospace"><%= batch.batchNumber %></span></td>
            <td class="text-nowrap"><%= batch.expiryDate.toISOString().slice(0, 10) %></td>
            <td class="text-end fw-semibold"><%= batch.quantity.toLocaleString() %></td>
            <td class="text-end text-nowrap">Rs. <%= batch.purchasePrice.toFixed(2) %></td>
            <td class="text-end text-nowrap">Rs. <%= batch.retailPrice.toFixed(2) %></td>
            <td>
              <% if (batch.quantity <= 0) { %>
                <span class="badge text-bg-secondary">Out of stock</span>
              <% } else if (expired) { %>
                <span class="badge text-bg-danger">Expired</span>
              <% } else if (nearExpiry) { %>
                <span class="badge text-bg-warning">Near expiry</span>
              <% } else { %>
                <span class="badge text-bg-success">Available</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
