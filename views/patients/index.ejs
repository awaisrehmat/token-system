<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Patient List</h1>
    <p class="text-secondary mb-0">Search and manage patient records.</p>
  </div>
  <a href="/patients/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Register Patient</a>
</div>

<div class="card app-card filter-card mb-4">
  <div class="card-body">
    <form action="/patients" method="get" class="row g-2">
      <div class="col-lg-7">
        <label for="search" class="visually-hidden">Search patients</label>
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="bi bi-search text-secondary"></i></span>
          <input type="search" class="form-control border-start-0 ps-0" id="search" name="search" value="<%= search %>" placeholder="Search MR number, patient/relative name, CNIC, contact, token, physician, or address">
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <label for="date" class="visually-hidden">Filter by date</label>
        <input type="date" class="form-control" id="date" name="date" value="<%= date %>">
      </div>
      <div class="col-sm-6 col-lg-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i> Search</button>
        <a href="/patients" class="btn btn-outline-secondary">Clear</a>
      </div>
    </form>
  </div>
</div>

<div class="card app-card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>MR Number</th><th>Token</th><th>Patient Name</th><th>Age</th><th>Sex</th><th>CNIC</th>
          <th>Contact</th><th>Physician</th><th>Type</th><th>Date</th><th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!patients.length) { %>
          <tr><td colspan="11" class="text-center text-secondary py-5">No patients found.</td></tr>
        <% } %>
        <% patients.forEach((patient) => { %>
          <tr>
            <td class="text-nowrap fw-semibold"><%= patient.mrNumber %></td>
            <td><span class="badge text-bg-primary fs-6"><%= patient.tokenNumber %></span></td>
            <td class="fw-medium">
              <%= patient.patientName %>
              <% if (patient.relationType && patient.relativeName) { %>
                <div class="small text-secondary"><%= patient.relationType %> <%= patient.relativeName %></div>
              <% } %>
            </td>
            <td class="text-nowrap"><%= patient.age %>y <%= patient.ageMonths || 0 %>m</td>
            <td><%= patient.sex %></td>
            <td class="text-nowrap"><%= formatCnic(patient.cnic) %></td>
            <td class="text-nowrap"><%= patient.contactNumber %></td>
            <td><%= patient.consultant ? patient.consultant.name : 'Deleted physician' %></td>
            <td><%= patient.patientType %></td>
            <td class="text-nowrap"><%= patient.tokenDate %></td>
            <td>
              <div class="d-flex flex-wrap gap-1">
                <a href="/patients/<%= patient._id %>/token" class="btn btn-sm btn-action btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                <a href="/patients/<%= patient._id %>/history" class="btn btn-sm btn-action btn-outline-dark" title="Patient History"><i class="bi bi-clock-history"></i></a>
                <button
                  type="button"
                  class="btn btn-sm btn-success text-nowrap new-token-button"
                  title="Generate New Token"
                  data-bs-toggle="modal"
                  data-bs-target="#newTokenModal"
                  data-patient-id="<%= patient._id %>"
                  data-patient-name="<%= patient.patientName %>"
                  data-mr-number="<%= patient.mrNumber %>"
                  data-physician-id="<%= patient.consultant ? patient.consultant._id : '' %>"
                ><i class="bi bi-ticket-perforated me-1"></i>New Token</button>
                <a href="/patients/<%= patient._id %>/edit" class="btn btn-sm btn-action btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                <a href="/patients/<%= patient._id %>/token?print=1" class="btn btn-sm btn-action btn-outline-success" title="Print Token"><i class="bi bi-printer"></i></a>
                <form action="/patients/<%= patient._id %>/delete" method="post" class="d-inline delete-form">
                  <button type="submit" class="btn btn-sm btn-action btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card-footer bg-white d-flex flex-wrap gap-3 align-items-center justify-content-between">
    <small class="text-secondary">
      <% if (total) { %>
        Showing <strong><%= ((page - 1) * pageSize) + 1 %></strong>–<strong><%= Math.min(page * pageSize, total) %></strong> of <strong><%= total.toLocaleString() %></strong> records
      <% } else { %>
        No records
      <% } %>
    </small>

    <% if (totalPages > 1) { %>
      <%
        const paginationUrl = (number) => `/patients?page=${number}&search=${encodeURIComponent(search)}&date=${encodeURIComponent(date)}`;
        const startPage = Math.max(1, page - 2);
        const endPage = Math.min(totalPages, page + 2);
      %>
      <nav aria-label="Patient list pages">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= page === 1 ? '#' : paginationUrl(page - 1) %>" aria-label="Previous"><i class="bi bi-chevron-left"></i></a>
          </li>

          <% if (startPage > 1) { %>
            <li class="page-item"><a class="page-link" href="<%= paginationUrl(1) %>">1</a></li>
            <% if (startPage > 2) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
          <% } %>

          <% for (let number = startPage; number <= endPage; number += 1) { %>
            <li class="page-item <%= number === page ? 'active' : '' %>">
              <a class="page-link" href="<%= paginationUrl(number) %>"><%= number %></a>
            </li>
          <% } %>

          <% if (endPage < totalPages) { %>
            <% if (endPage < totalPages - 1) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
            <li class="page-item"><a class="page-link" href="<%= paginationUrl(totalPages) %>"><%= totalPages %></a></li>
          <% } %>

          <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="<%= page === totalPages ? '#' : paginationUrl(page + 1) %>" aria-label="Next"><i class="bi bi-chevron-right"></i></a>
          </li>
        </ul>
      </nav>
    <% } %>
  </div>
</div>

<div class="modal fade" id="newTokenModal" tabindex="-1" aria-labelledby="newTokenModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="newTokenForm" action="" method="post">
        <div class="modal-header">
          <div>
            <h2 class="modal-title fs-5" id="newTokenModalLabel">Generate New Token</h2>
            <p class="small text-secondary mb-0" id="newTokenPatient"></p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="repeatConsultant" class="form-label">Physician</label>
            <select class="form-select" id="repeatConsultant" name="consultant" required>
              <option value="">Select physician</option>
              <% consultants.forEach((physician) => { %>
                <option value="<%= physician._id %>"><%= physician.name %> — <%= physician.specialization %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="repeatPatientType" class="form-label">Patient Type</label>
            <input type="text" class="form-control" id="repeatPatientType" name="patientType" maxlength="60" value="Follow-up" required>
          </div>
          <div>
            <label for="repeatDescription" class="form-label">Description</label>
            <textarea class="form-control" id="repeatDescription" name="description" rows="3" maxlength="1000"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-printer me-1"></i> Generate & Print</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
