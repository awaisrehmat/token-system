<%- include('../partials/header') %>

<div class="page-heading d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1"><%= isEdit ? 'Edit Patient' : 'Register Patient' %></h1>
    <p class="text-secondary mb-0"><%= isEdit ? 'Update the patient record.' : 'Create a new patient token.' %></p>
  </div>
  <a href="/patients" class="btn btn-outline-secondary">Patient List</a>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger" role="alert">
    <strong>Please fix the following:</strong>
    <ul class="mb-0 mt-2">
      <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
    </ul>
  </div>
<% } %>

<div class="card app-card">
  <div class="card-header bg-white py-3 px-4">
    <h2 class="h5 mb-0"><i class="bi bi-person-vcard me-2 text-primary"></i>Patient Information</h2>
  </div>
  <div class="card-body p-4">
    <form action="<%= isEdit ? `/patients/${patient._id}/update` : '/patients' %>" method="post" class="row g-3" novalidate>
      <% if (isEdit) { %>
        <div class="col-12">
          <label class="form-label">Medical Record Number</label>
          <input type="text" class="form-control" value="<%= patient.mrNumber || '' %>" disabled>
          <div class="form-text">This permanent number is generated automatically and cannot be changed.</div>
        </div>
      <% } %>
      <div class="col-md-6">
        <label for="patientName" class="form-label">Patient Name</label>
        <input type="text" class="form-control" id="patientName" name="patientName" maxlength="100" value="<%= patient.patientName || '' %>" required>
      </div>
      <div class="col-md-2">
        <label for="relationType" class="form-label">Relation</label>
        <select class="form-select" id="relationType" name="relationType" required>
          <option value="">Select</option>
          <% ['S/O', 'W/O', 'D/O'].forEach((relation) => { %>
            <option value="<%= relation %>" <%= patient.relationType === relation ? 'selected' : '' %>><%= relation %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="relativeName" class="form-label">Father / Husband Name</label>
        <input type="text" class="form-control" id="relativeName" name="relativeName" maxlength="100" value="<%= patient.relativeName || '' %>" required>
      </div>
      <div class="col-md-3">
        <label for="age" class="form-label">Age</label>
        <input type="number" class="form-control" id="age" name="age" min="0" max="130" value="<%= patient.age ?? '' %>" required>
      </div>
      <div class="col-md-3">
        <label for="sex" class="form-label">Sex</label>
        <select class="form-select" id="sex" name="sex" required>
          <option value="">Select</option>
          <% ['Male', 'Female', 'Other'].forEach((value) => { %>
            <option value="<%= value %>" <%= patient.sex === value ? 'selected' : '' %>><%= value %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-6">
        <label for="cnic" class="form-label">CNIC</label>
        <input type="text" class="form-control" id="cnic" name="cnic" inputmode="numeric" maxlength="15" placeholder="12345-1234567-1" value="<%= patient.cnic || '' %>" required>
        <div class="form-text">Enter 13 digits, with or without dashes.</div>
      </div>
      <div class="col-md-6">
        <label for="contactNumber" class="form-label">Contact Number</label>
        <input type="text" class="form-control" id="contactNumber" name="contactNumber" maxlength="30" value="<%= patient.contactNumber || '' %>" required>
      </div>

      <div class="col-12">
        <label for="address" class="form-label">Address</label>
        <input type="text" class="form-control" id="address" name="address" maxlength="250" value="<%= patient.address || '' %>" required>
      </div>

      <div class="col-md-6">
        <label for="consultant" class="form-label">Physician Name</label>
        <div class="input-group">
          <select class="form-select" id="consultant" name="consultant" required>
            <option value="">Select physician</option>
            <% consultants.forEach((consultant) => { %>
              <option value="<%= consultant._id %>" <%= String(patient.consultant || '') === String(consultant._id) ? 'selected' : '' %>>
                <%= consultant.name %> — <%= consultant.specialization %>
              </option>
            <% }) %>
          </select>
          <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#consultantModal">Add Physician</button>
        </div>
        <% if (!consultants.length) { %><div class="form-text text-danger">Add a physician before saving this patient.</div><% } %>
      </div>
      <div class="col-md-6">
        <label for="patientType" class="form-label">Patient Type</label>
        <input type="text" class="form-control" id="patientType" name="patientType" maxlength="60" placeholder="e.g. New, Follow-up, Emergency" value="<%= patient.patientType || '' %>" required>
      </div>

      <div class="col-12">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3" maxlength="1000"><%= patient.description || '' %></textarea>
      </div>

      <% if (isEdit) { %>
        <div class="col-md-6">
          <label class="form-label">Token / Serial Number</label>
          <input type="text" class="form-control" value="<%= patient.tokenNumber || '' %>" disabled>
          <div class="form-text">Token numbers are generated and managed automatically.</div>
        </div>
      <% } %>
      <div class="<%= isEdit ? 'col-md-6' : 'col-12' %>">
        <label for="tokenDate" class="form-label">Date and Time</label>
        <input type="date" class="form-control" id="tokenDate" name="tokenDate" value="<%= patient.tokenDate || '' %>" required>
        <div class="form-text">The current time is saved automatically on registration.</div>
      </div>

      <div class="col-12 d-flex gap-2 pt-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> <%= isEdit ? 'Update Patient' : 'Register & View Token' %></button>
        <a href="/patients" class="btn btn-light">Cancel</a>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="consultantModal" tabindex="-1" aria-labelledby="consultantModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/consultants" method="post">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="consultantModalLabel">Add Physician</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="returnTo" value="<%= isEdit ? `/patients/${patient._id}/edit` : '/patients/new' %>">
          <div class="mb-3">
            <label for="consultantName" class="form-label">Physician Name</label>
            <input type="text" class="form-control" id="consultantName" name="name" maxlength="100" required>
          </div>
          <div>
            <label for="specialization" class="form-label">Specialization</label>
            <input type="text" class="form-control" id="specialization" name="specialization" maxlength="100" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Physician</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
