<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= clinicName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/token.css">
</head>
<body>
  <div class="no-print controls">
    <% if (message) { %><div class="alert alert-success py-2"><%= message %></div><% } %>
    <a href="/patients" class="btn btn-outline-secondary">Patient List</a>
    <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
  </div>

  <article class="token-receipt">
    <header>
      <h1><%= printSetting.header %></h1>
      <p>Patient Token</p>
    </header>
    <div class="divider"></div>
    <p class="token-label">TOKEN NUMBER</p>
    <div class="token-number"><%= patient.tokenNumber %></div>
    <div class="divider"></div>
    <dl>
      <div><dt>Patient</dt><dd><%= patient.patientName %></dd></div>
      <div><dt>Age / Sex</dt><dd><%= patient.age %> / <%= patient.sex %></dd></div>
      <div><dt>CNIC</dt><dd><%= formatCnic(patient.cnic) %></dd></div>
      <div><dt>Consultant</dt><dd><%= patient.consultant ? patient.consultant.name : 'Not available' %></dd></div>
      <div><dt>Patient Type</dt><dd><%= patient.patientType %></dd></div>
      <div><dt>Date & Time</dt><dd><%= formatDateTime(patient.createdAt) %></dd></div>
      <div class="description"><dt>Description</dt><dd><%= patient.description || '—' %></dd></div>
    </dl>
    <div class="divider"></div>
    <p class="wait-message"><%= printSetting.footer %></p>
  </article>

  <% if (String(typeof query !== 'undefined' ? query.print : '') === '1') { %>
    <script>window.addEventListener('load', function () { window.print(); });</script>
  <% } %>
</body>
</html>
