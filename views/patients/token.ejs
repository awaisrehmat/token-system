<!doctype html>
<html lang="en" class="<%= printSetting.tokenPaperSize === 'A4' ? 'token-paper-a4' : 'token-paper-80mm' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= clinicName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/token.css">
  <% if (printSetting.tokenPaperSize === 'A4') { %><style>@page { size: A4 portrait; margin: 0; }</style><% } %>
</head>
<body class="<%= printSetting.tokenPaperSize === 'A4' ? 'token-paper-a4' : 'token-paper-80mm' %>">
  <div class="no-print controls">
    <% if (message) { %><div class="alert alert-success py-2"><%= message %></div><% } %>
    <a href="/patients" class="btn btn-outline-secondary">Patient List</a>
    <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
  </div>

  <% if (printSetting.tokenPaperSize === 'A4') { %>
  <article class="a4-prescription">
    <header class="a4-clinic-header">
      <div class="a4-clinic-identity"><h1><%= printSetting.header %></h1><% String(printSetting.a4ClinicDetails || '').split('\n').filter(Boolean).forEach((line) => { %><p><%= line %></p><% }) %></div>
      <div class="a4-doctor"><strong><%= patient.consultant ? patient.consultant.name : 'Consulting Physician' %></strong><span><%= patient.consultant?.specialization || 'Medical Consultant' %></span></div>
    </header>
    <div class="a4-reference-row"><strong class="a4-token"><span>Token</span> <%= patient.tokenNumber %></strong><strong>MR # <%= patient.mrNumber %></strong></div>
    <section class="a4-patient-band">
      <div><span>Patient Name</span><strong><%= patient.patientName %></strong></div>
      <div><span>Relation</span><strong><%= patient.relationType && patient.relativeName ? `${patient.relationType} ${patient.relativeName}` : '—' %></strong></div>
      <div><span>No. of Visit</span><strong><%= patient.patientType %></strong></div>
      <div><span>Time</span><strong><%= patient.createdAt.toLocaleTimeString('en-PK', { hour: '2-digit', minute: '2-digit' }) %></strong></div>
      <div><span>Date</span><strong><%= patient.createdAt.toLocaleDateString('en-PK') %></strong></div>
      <div class="a4-wide"><span>Address</span><strong><%= patient.address %></strong></div>
      <div><span>Contact No.</span><strong><%= patient.contactNumber %></strong></div>
    </section>
    <section class="a4-work-area">
      <aside class="a4-notes-column">
        <div><strong>B.P</strong><span></span></div>
        <div><strong>Pulse</strong><span></span></div>
        <div><strong>Temperature</strong><span></span></div>
        <div><strong>R.R</strong><span></span></div>
        <div><strong>Allergies</strong><span></span></div>
        <div><strong>Presenting Complaints</strong><span></span></div>
        <div><strong>History</strong><span></span></div>
        <div><strong>Findings</strong><span></span></div>
        <div><strong>Investigations</strong><span></span></div>
        <div><strong>VCO</strong><span></span></div>
      </aside>
      <main class="a4-rx-area">
        <section class="a4-clinical-summary">
          <div><span>Age</span><strong><%= patient.age %>y <%= patient.ageMonths || 0 %>m</strong></div>
          <div><span>Gender</span><strong><%= patient.sex %></strong></div>
          <div><span>Weight (kg)</span><strong>&nbsp;</strong></div>
          <div class="a4-diagnosis"><span>Provisional / Diagnosis</span><strong><%= patient.description || '' %></strong></div>
        </section>
        <div class="a4-rx-mark">Rx</div><div class="a4-signature">Signature &amp; Stamp</div>
      </main>
    </section>
    <footer class="a4-prescription-footer"><span><%= printSetting.a4FooterLeft || printSetting.footer %></span><span class="a4-doctor-marks" aria-label="Refill marking options"><em>Refill</em><b>0</b><b>1</b><b>2</b><b>3</b><b>4</b></span><span><%= printSetting.a4FooterRight || patient.consultant?.name || '' %></span></footer>
  </article>
  <% } else { %>
  <article class="token-receipt">
    <header>
      <h1><%= printSetting.header %></h1>
      <p>Patient Token</p>
    </header>
    <div class="divider"></div>
    <p class="token-label">TOKEN NUMBER</p>
    <div class="token-number"><%= patient.tokenNumber %></div>
    <p class="mr-number"><span>MR NUMBER</span> <strong><%= patient.mrNumber %></strong></p>
    <div class="divider"></div>
    <dl>
      <div><dt>Patient</dt><dd><%= patient.patientName %></dd></div>
      <% if (patient.relationType && patient.relativeName) { %>
        <div><dt><%= patient.relationType %></dt><dd><%= patient.relativeName %></dd></div>
      <% } %>
      <div><dt>Age / Sex</dt><dd><%= patient.age %>y <%= patient.ageMonths || 0 %>m / <%= patient.sex %></dd></div>
      <div><dt>CNIC</dt><dd><%= formatCnic(patient.cnic) %></dd></div>
      <div><dt>Phone</dt><dd><%= patient.contactNumber %></dd></div>
      <div><dt>Address</dt><dd><%= patient.address %></dd></div>
      <div><dt>Physician</dt><dd><%= patient.consultant ? patient.consultant.name : 'Not available' %></dd></div>
      <div><dt>Patient Type</dt><dd><%= patient.patientType %></dd></div>
      <div><dt>Date & Time</dt><dd><%= formatDateTime(patient.createdAt) %></dd></div>
      <div class="description"><dt>Description</dt><dd><%= patient.description || '—' %></dd></div>
    </dl>
    <div class="divider"></div>
    <p class="wait-message"><%= printSetting.footer %></p>
  </article>
  <% } %>

  <% if (String(typeof query !== 'undefined' ? query.print : '') === '1') { %>
    <script>window.addEventListener('load', function () { window.print(); });</script>
  <% } %>
</body>
</html>
