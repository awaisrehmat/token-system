<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= clinicName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
      <a class="sidebar-brand" href="/">
        <span class="brand-mark"><i class="bi bi-hospital"></i></span>
        <span class="sidebar-brand-copy">
          <strong><%= clinicName %></strong>
          <small>Management System</small>
        </span>
      </a>

      <nav class="sidebar-nav">
        <div class="sidebar-section">
          <span class="sidebar-label">Overview</span>
          <a class="sidebar-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
            <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
          </a>
        </div>

        <% if (can('patients.manage') || can('physicians.view') || can('physicians.manage')) { %>
        <div class="sidebar-section">
          <span class="sidebar-label">Clinic</span>
          <% if (can('patients.manage')) { %>
          <a class="sidebar-link <%= currentPath === '/patients/new' ? 'active' : '' %>" href="/patients/new">
            <i class="bi bi-person-plus"></i><span>Register Patient</span>
          </a>
          <a class="sidebar-link <%= currentPath === '/patients' || (/^\/patients\/[^/]+/.test(currentPath) && currentPath !== '/patients/new') ? 'active' : '' %>" href="/patients">
            <i class="bi bi-people"></i><span>Patients</span>
          </a>
          <% } %>
          <% if (can('physicians.view') || can('physicians.manage')) { %>
          <a class="sidebar-link <%= currentPath === '/consultants' ? 'active' : '' %>" href="/consultants">
            <i class="bi bi-person-badge"></i><span>Physicians</span>
          </a>
          <% } %>
        </div>
        <% } %>

        <% if (can('inventory.view') || can('sales.manage') || can('stock.upload')) { %>
        <div class="sidebar-section">
          <span class="sidebar-label">Pharmacy</span>
          <% if (can('inventory.view')) { %>
          <a class="sidebar-link <%= currentPath === '/inventory' ? 'active' : '' %>" href="/inventory">
            <i class="bi bi-box-seam"></i><span>Medicine Stock</span>
          </a>
          <% } %>
          <% if (can('sales.manage')) { %>
          <a class="sidebar-link <%= currentPath === '/inventory/sale' ? 'active' : '' %>" href="/inventory/sale">
            <i class="bi bi-cart-plus"></i><span>New Sale</span>
          </a>
          <a class="sidebar-link <%= currentPath === '/inventory/sales' ? 'active' : '' %>" href="/inventory/sales">
            <i class="bi bi-receipt"></i><span>Sales History</span>
          </a>
          <% } %>
          <% if (can('stock.upload')) { %>
          <a class="sidebar-link <%= currentPath === '/inventory/add' ? 'active' : '' %>" href="/inventory/add">
            <i class="bi bi-plus-circle"></i><span>Add Stock</span>
          </a>
          <a class="sidebar-link <%= currentPath === '/inventory/upload' ? 'active' : '' %>" href="/inventory/upload">
            <i class="bi bi-cloud-arrow-up"></i><span>Upload Stock</span>
          </a>
          <% } %>
        </div>
        <% } %>

        <% if (can('users.manage')) { %>
        <div class="sidebar-section">
          <span class="sidebar-label">Administration</span>
          <a class="sidebar-link <%= currentPath.startsWith('/users') ? 'active' : '' %>" href="/users">
            <i class="bi bi-shield-lock"></i><span>Users &amp; Permissions</span>
          </a>
        </div>
        <% } %>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <span class="sidebar-user-avatar"><i class="bi bi-person"></i></span>
          <span><small><%= currentRole || 'Account' %></small><strong><%= displayName || currentUser || 'Admin' %></strong></span>
        </div>
        <form action="/logout" method="post">
          <button type="submit" class="sidebar-logout" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button>
        </form>
      </div>
    </aside>

    <button class="sidebar-backdrop" id="sidebarBackdrop" type="button" aria-label="Close navigation"></button>

    <div class="admin-content">
      <header class="admin-topbar">
        <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-controls="adminSidebar" aria-expanded="false">
          <i class="bi bi-list"></i><span class="visually-hidden">Open navigation</span>
        </button>
        <div>
          <p class="admin-topbar-eyebrow mb-0">Administration</p>
          <p class="admin-topbar-title mb-0"><%= title %></p>
        </div>
        <div class="admin-topbar-user ms-auto">
          <span class="admin-status-dot"></span><span><%= displayName || currentUser || 'Admin' %></span>
        </div>
      </header>

      <main class="admin-main">
        <% if (message) { %>
          <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        <% if (errorMessage) { %>
          <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i><%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
