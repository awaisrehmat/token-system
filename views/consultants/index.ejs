<%- include('../partials/header') %>

<div class="page-heading mb-4">
  <h1 class="h3 mb-1">Physician Management</h1>
  <p class="text-secondary mb-0"><%= can('physicians.manage') ? 'Add and manage clinic physicians.' : 'View clinic physicians.' %></p>
</div>

<div class="row g-4">
  <% if (can('physicians.manage')) { %>
  <div class="col-lg-4">
    <div class="card app-card">
      <div class="card-header bg-white py-3"><h2 class="h5 mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Add Physician</h2></div>
      <div class="card-body">
        <form action="/consultants" method="post">
          <div class="mb-3">
            <label for="name" class="form-label">Physician Name</label>
            <input type="text" class="form-control" id="name" name="name" maxlength="100" required>
          </div>
          <div class="mb-3">
            <label for="specialization" class="form-label">Specialization / Qualification</label>
            <textarea class="form-control" id="specialization" name="specialization" maxlength="300" rows="4" required></textarea>
            <div class="form-text">Use a new line for each qualification or registration detail.</div>
          </div>
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i> Add Physician</button>
        </form>
      </div>
    </div>
  </div>
  <% } %>
  <div class="<%= can('physicians.manage') ? 'col-lg-8' : 'col-12' %>">
    <div class="card app-card overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light"><tr><th>Name</th><th>Specialization / Qualification</th><% if (can('physicians.manage')) { %><th class="text-end">Action</th><% } %></tr></thead>
          <tbody>
            <% if (!consultants.length) { %>
              <tr><td colspan="<%= can('physicians.manage') ? 3 : 2 %>" class="text-center text-secondary py-5">No physicians added yet.</td></tr>
            <% } %>
            <% consultants.forEach((consultant) => { %>
              <tr>
                <td class="fw-medium"><%= consultant.name %></td>
                <td class="physician-specialization"><%= consultant.specialization %></td>
                <% if (can('physicians.manage')) { %><td class="text-end"><button type="button" class="btn btn-sm btn-action btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPhysician<%= consultant._id %>" title="Edit physician"><i class="bi bi-pencil"></i></button></td><% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if (can('physicians.manage')) { consultants.forEach((consultant) => { %>
  <div class="modal fade" id="editPhysician<%= consultant._id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><form action="/consultants/<%= consultant._id %>/update" method="post">
      <div class="modal-header"><h2 class="modal-title fs-5">Edit Physician</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label" for="editName<%= consultant._id %>">Physician Name</label><input class="form-control" id="editName<%= consultant._id %>" name="name" maxlength="100" value="<%= consultant.name %>" required></div>
        <div><label class="form-label" for="editSpecialization<%= consultant._id %>">Specialization / Qualification</label><textarea class="form-control" id="editSpecialization<%= consultant._id %>" name="specialization" maxlength="300" rows="5" required><%= consultant.specialization %></textarea><div class="form-text">Line breaks are preserved on the A4 prescription.</div></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Changes</button></div>
    </form></div></div>
  </div>
<% }) } %>

<%- include('../partials/footer') %>
